# ============================================================
# ClubBoost — Environment Variables
#
# Copy to .env.local for local development.
# Never commit .env.local to version control.
# ============================================================


# ── Supabase ────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ── Stripe (platform account) ────────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys
# Use test keys (sk_test_ / pk_test_) for development.

# Platform secret key — server-side only, never exposed to client
STRIPE_SECRET_KEY=sk_test_...

# Publishable key — safe to expose in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — from Stripe CLI or Stripe Dashboard
# CLI:       stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Dashboard: Developers → Webhooks → Endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Connect webhook secret — if you use a separate Connect webhook endpoint
# (Optional in MVP — the same STRIPE_WEBHOOK_SECRET works for both)
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...


# ── App ─────────────────────────────────────────────────────

# Base URL used in Stripe redirect_url, email links, etc.
# In development: http://localhost:3000
# In production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Email ────────────────────────────────────────────────────
# Provider: 'resend' (production) or 'console' (development — logs to stdout)
EMAIL_PROVIDER=console

# Resend — https://resend.com
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...

# The From address for all outbound email.
# Must be a verified domain in your Resend account.
EMAIL_FROM=hello@clubboost.co.uk

# Shown in email footers and error pages
SUPPORT_EMAIL=support@clubboost.co.uk


# ── Admin ────────────────────────────────────────────────────
# Email address of the platform superadmin account.
# This user gets the 'platform_admin' role in the profiles table.
PLATFORM_ADMIN_EMAIL=your@email.com

# Secret passed in the Authorization header by Vercel Cron
# to authenticate /api/notifications/retry calls.
# Generate: openssl rand -base64 32
CRON_SECRET=your-random-secret-here
